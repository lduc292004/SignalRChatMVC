@using System.Linq
@{
    ViewData["Title"] = "SignalR Pro Chat";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<div class="chat-container">
    <h2>🔥 SignalR Super Chat</h2>

    <div class="chat-top">
        <input type="text" id="userInput" placeholder="Tên của bạn..." />
        <button id="connectBtn">Kết nối</button>
    </div>

    <div class="chat-body">
        <div class="users-box">
            <h4>🟢 Người dùng online</h4>
            <ul id="userList"></ul>
        </div>

        <div class="chat-box">
            <div id="messagesList" class="messages"></div>

            <div id="stickerBoard" style="display: none; position: absolute; bottom: 180px; right: 20px; z-index: 1000; background: #2a2a2a; border: 1px solid #444; padding: 10px; border-radius: 8px; width: 250px;">
                <p class="text-white small mb-2" style="margin-bottom: 5px; color: #eee;">Chọn Sticker</p>
                <div id="stickerList" style="display: flex; flex-wrap: wrap; gap: 8px; max-height: 180px; overflow-y: auto; padding-right: 5px;">
                </div>
            </div>
            <div class="chat-input-area">

                <div class="chat-input">
                    <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." />
                    <button id="toggleStickerBtn" title="Thả Sticker" style="margin-right: 5px; background: #f0ad4e; color: #1b1b1b; border: none; border-radius: 6px; padding: 8px 12px; cursor: pointer;">
                        <i class="fas fa-laugh-beam"></i>
                    </button>
                    <button id="sendButton">Gửi</button>
                </div>

                <div class="file-upload-area">
                    <input type="file" id="fileUpload" name="file" style="display: none;"
                           accept="image/*, application/pdf, .zip, .rar, .docx, .xlsx, .txt" />

                    <button type="button" id="selectFileBtn" onclick="document.getElementById('fileUpload').click()">
                        <i class="fas fa-paperclip"></i> Chọn File
                    </button>
                    <button id="sendFileButton">Gửi File Đã Chọn</button>
                </div>


            </div>
        </div>
    </div>
</div>

<audio id="notifySound" src="https://cdn.pixabay.com/download/audio/2021/09/20/audio_c4c8d8c3cb.mp3" preload="auto"></audio>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            let connection;
            let username;

            // Hàm trả về tên nhóm hiện tại (Giả định là chat chung, nên trả về chuỗi rỗng)
            function getCurrentActiveGroup() { return ""; }
            function playSound() { document.getElementById("notifySound").play().catch(e => console.log("Không thể play âm thanh")); }
            function showStatus(text) {
                const msgList = document.getElementById("messagesList");
                const msg = document.createElement("div");
                msg.classList.add("status");
                msg.textContent = text;
                msgList.appendChild(msg);
                msgList.scrollTop = msgList.scrollHeight;
            }

            // ======================================================
            // B. HÀM HIỂN THỊ TIN NHẮN CHUNG (TÍCH HỢP STICKER)
            // ======================================================
            function displayMessage(messageData, listId) {
                const msgList = document.getElementById(listId);
                const msg = document.createElement("div");
                msg.classList.add("msg");

                let contentHtml = "";

                // 1. Xử lý nội dung (Image, File, Text, Sticker)
                if (messageData.type === "image") {
                    contentHtml = `<a href="${messageData.content}" target="_blank">
                                        <img src="${messageData.content}" alt="${messageData.originalFileName || 'Ảnh được gửi'}"
                                             class="chat-image"/>
                                    </a>`;
                } else if (messageData.type === "file") {
                    contentHtml = `<i class="fas fa-file-alt"></i> File:
                                        <a href="${messageData.content}" download="${messageData.originalFileName}">
                                            ${messageData.originalFileName}
                                        </a>`;
                } else {
                    // Nếu là tin nhắn văn bản ('text')
                    // 🚨 Cập nhật logic kiểm tra đường dẫn sticker: /lib/stickers/
                    if (messageData.content && messageData.content.startsWith("/stickers/") && messageData.content.match(/\.(png|gif|jpg|jpeg)$/i)) {
                        // ✅ Sửa: Bọc sticker trong thẻ div.sticker-wrapper
                        contentHtml = `<div class="sticker-wrapper"><img src="${messageData.content}" class="sticker-in-chat" style="width: 80px; height: 80px;"/></div>`;
                    } else {
                        contentHtml = messageData.content;
                    }
                }

                // 2. Gắn nội dung và thông tin người gửi
                msg.innerHTML = `<b>${messageData.user} [${messageData.time}]:</b><br/> ${contentHtml}`;

                // 3. Phân loại tin nhắn của tôi
                if (messageData.user === username) msg.classList.add("me");

                // 4. Thêm vào list và cuộn xuống
                msgList.appendChild(msg);
                msgList.scrollTop = msgList.scrollHeight;
            }

            // ======================================================
            // CHỨC NĂNG STICKER (KHỞI TẠO & GỬI)
            // ======================================================

            // Danh sách tên file sticker dựa trên cấu trúc /wwwroot/lib/stickers/
            const STICKER_FILES = [
                "1.jpg", "2.jpg", "3.jpg",
                "4.jpg", "5.jpg", "6.jpg",
                "7.jpg", "8.jpg", "9.jpg"
                // Thêm các tên file khác của bạn nếu có
            ];

            const stickerList = document.getElementById('stickerList');
            STICKER_FILES.forEach(fileName => {
                const img = document.createElement('img');
                // 🚨 Đường dẫn sử dụng: /lib/stickers/
                const stickerUrl = `/stickers/${fileName}`;

                img.src = stickerUrl;
                img.alt = fileName;
                img.className = 'sticker-item'; // Class mới cho CSS
                img.style.width = '40px';
                img.style.height = '40px';
                img.style.cursor = 'pointer';
                img.style.borderRadius = '5px';

                // Thêm sự kiện click để gửi sticker
                img.addEventListener('click', function() {
                    sendSticker(stickerUrl);
                });

                stickerList.appendChild(img);
            });

            // Logic bật/tắt bảng sticker
            document.getElementById('toggleStickerBtn').addEventListener('click', function() {
                const stickerBoard = document.getElementById('stickerBoard');
                stickerBoard.style.display = stickerBoard.style.display === 'none' ? 'block' : 'none';
            });

            // Hàm gửi Sticker
            async function sendSticker(stickerUrl) {
                if (!connection) return alert("Chưa kết nối!");
                const currentGroupName = getCurrentActiveGroup();

                try {
                    if (currentGroupName) {
                        await connection.invoke("SendGroupMessage", currentGroupName, username, stickerUrl);
                    } else {
                        await connection.invoke("SendMessage", username, stickerUrl);
                    }
                } catch (err) {
                    console.error("Lỗi khi gửi sticker:", err.toString());
                }

                // Ẩn bảng sticker sau khi gửi
                document.getElementById('stickerBoard').style.display = 'none';
            }


            // ======================================================
            // ĐIỀU KHIỂN CHAT (GIỮ NGUYÊN)
            // ======================================================

            document.getElementById("connectBtn").addEventListener("click", async () => {
                username = document.getElementById("userInput").value.trim();
                if (!username) return alert("Nhập tên trước khi tham gia!");

                const hubUrl = `${window.location.origin}/chatHub?username=${encodeURIComponent(username)}`;

                connection = new signalR.HubConnectionBuilder()
                    .withUrl(hubUrl)
                    .build();

                connection.on("ReceiveMessage", (messageData) => {
                    displayMessage(messageData, "messagesList");
                    playSound();
                });

                connection.on("ReceiveGroupMessage", (groupName, messageData) => {
                    displayMessage(messageData, "messagesList");
                    playSound();
                });

                connection.on("UserJoined", (user) => { showStatus(`${user} đã tham gia`); });
                connection.on("UserLeft", (user) => { showStatus(`${user} đã rời đi`); });
                connection.on("UpdateUserList", (users) => {
                    const list = document.getElementById("userList");
                    list.innerHTML = "";
                    users.forEach(u => {
                        const li = document.createElement("li");
                        li.textContent = u;
                        list.appendChild(li);
                    });
                });

                try {
                    await connection.start();
                    document.querySelector(".chat-top").style.display = "none";
                    document.querySelector(".chat-body").style.display = "flex";
                } catch (err) {
                    console.error("Lỗi khi kết nối SignalR:", err);
                    alert("Không thể kết nối tới server chat.");
                }
            });

            // Nút Gửi tin nhắn (Text)
            document.getElementById("sendButton").addEventListener("click", async () => {
                const message = document.getElementById("messageInput").value.trim();
                const currentGroupName = getCurrentActiveGroup();

                if (message && connection) {
                    if (currentGroupName) {
                         await connection.invoke("SendGroupMessage", currentGroupName, username, message);
                    } else {
                         await connection.invoke("SendMessage", username, message);
                    }
                }
                document.getElementById("messageInput").value = "";
                // Ẩn bảng sticker
                document.getElementById('stickerBoard').style.display = 'none';
            });

            // Nút Gửi File (Upload)
            document.getElementById("sendFileButton").addEventListener("click", async () => {
                const fileInput = document.getElementById("fileUpload");
                const file = fileInput.files[0];

                if (!file) {
                    alert("Vui lòng chọn file trước.");
                    return;
                }
                if (!connection) {
                    alert("Chưa kết nối!");
                    return;
                }

                const currentGroupName = getCurrentActiveGroup();
                const isGroup = !!currentGroupName;

                const formData = new FormData();
                formData.append("file", file);
                formData.append("senderName", username);
                formData.append("isGroupMessage", isGroup);
                formData.append("targetName", isGroup ? currentGroupName : "");

                try {
                    // Gọi API upload file trên FilesController
                    const response = await fetch(`/api/upload`, {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        const errorResult = await response.json();
                        throw new Error(errorResult.message || "Lỗi không xác định khi upload.");
                    }

                    fileInput.value = "";

                } catch (error) {
                    console.error("Lỗi khi upload file:", error);
                    alert("Đã xảy ra lỗi khi upload: " + error.message);
                }
            });

            // Xóa đoạn code lắng nghe click sticker cũ không hoạt động (đã thay bằng logic khởi tạo bên trên)
            // document.querySelectorAll(".sticker").forEach(item => { ... });

        }); // Đóng 'DOMContentLoaded'
    </script>

    <style>
        /* [THÊM] Class cho sticker trong tin nhắn */
        .sticker-in-chat {
            max-width: 80px;
            max-height: 80px;
            border-radius: 5px;
            display: block;
            margin-top: 5px;
            background-color: transparent; /* Đảm bảo không có nền đen khi là sticker */
        }

        /* [THÊM] CSS cho Sticker trong bảng chọn */
        .sticker-item {
            transition: transform 0.2s ease;
            background-color: #333;
            border-radius: 5px;
            padding: 2px;
        }

            .sticker-item:hover {
                transform: scale(1.15);
                box-shadow: 0 0 5px #f0ad4e;
            }


        /* Giữ nguyên CSS cũ để đảm bảo giao diện */
        body {
            background: #111;
            color: #eee;
            font-family: 'Segoe UI', sans-serif;
        }

        .chat-container {
            width: 900px;
            margin: 40px auto;
            background: #1b1b1b;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 10px #333;
            position: relative; /* Quan trọng để định vị tuyệt đối bảng sticker */
        }

        .chat-body {
            display: none;
            gap: 20px;
        }

        .users-box {
            width: 200px;
            background: #222;
            padding: 10px;
            border-radius: 8px;
            height: fit-content;
        }

        #userList li {
            padding: 2px 5px;
            border-radius: 4px;
        }

            #userList li:nth-child(odd) {
                background-color: #333;
            }

        .chat-box {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .messages {
            height: 400px;
            overflow-y: auto;
            background: #000;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #333;
        }

        .chat-input-area {
            background: #222;
            padding: 10px;
            border-radius: 8px;
            margin-top: 10px;
            border: 1px solid #333;
        }

        .chat-input {
            display: flex;
        }

            .chat-input input {
                flex: 1;
                padding: 8px;
                border-radius: 6px;
                border: 1px solid #444;
                background-color: #222;
                color: #eee;
                margin-right: 5px;
            }

            .chat-input button {
                padding: 8px 12px;
                background: #28a745;
                border: none;
                border-radius: 6px;
                color: #fff;
                cursor: pointer;
            }

        .file-upload-area {
            display: flex;
            margin-top: 10px;
        }

            .file-upload-area button {
                padding: 8px 12px;
                background: #555;
                border: none;
                border-radius: 6px;
                color: #fff;
                cursor: pointer;
            }

                .file-upload-area button:hover {
                    background: #666;
                }

        .msg {
            margin: 4px 0;
            padding: 5px;
            line-height: 1.4;
        }

            .msg.me {
                text-align: right;
                color: #70dbff;
            }

                .msg.me b {
                    color: #70dbff;
                }

            .msg b {
                color: #0f0;
            }

        .status {
            text-align: center;
            color: #888;
            font-style: italic;
            margin: 5px 0;
        }

        .chat-image {
            max-width: 250px;
            max-height: 200px;
            border-radius: 8px;
            display: block;
            margin-top: 5px;
            background-color: #333;
        }

        .msg.me .chat-image {
            margin-left: auto;
        }

        .msg a {
            color: #1e90ff;
            text-decoration: none;
            background-color: #2a2a2a;
            padding: 5px 8px;
            border-radius: 5px;
            border: 1px solid #444;
        }

            .msg a:hover {
                text-decoration: underline;
                background-color: #333;
            }
       

        .msg.me .sticker-wrapper {
            
            width: fit-content;
            margin-left: auto;
            display: block;
        }
    </style>
}