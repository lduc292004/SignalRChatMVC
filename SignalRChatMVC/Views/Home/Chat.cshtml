@{
	ViewData["Title"] = "Chat";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<div class="container-fluid py-3">
	<div class="row">
		<div class="col-md-2 border-end" style="height: 60vh; overflow-y: auto;">
			<h5 class="mb-3 text-primary">Người dùng online</h5>
			<ul id="userList" class="list-group mb-4"></ul>

			<h5 class="text-primary">Nhóm chat</h5>
			<ul id="groupList" class="list-group mb-3"></ul>

			<button class="btn btn-sm btn-outline-success w-100" data-bs-toggle="modal" data-bs-target="#createGroupModal">
				➕ Tạo nhóm
			</button>
			<button id="publicChatBtn" class="btn btn-sm btn-info w-100 mt-2">
				💬 Chat chung
			</button>
		</div>

		<div class="col-md-7 d-flex flex-column">
			<div id="messages" class="flex-grow-1 border rounded p-3 mb-2" style="overflow-y: auto; background: #f8f9fa;"></div>
			<div class="d-flex gap-2">
				<input id="messageInput" class="form-control" placeholder="Nhập tin nhắn..." />
				<input type="file" id="fileInput" hidden />
				<button id="sendBtn" class="btn btn-primary">Gửi</button>
				<button id="sendFileBtn" class="btn btn-outline-secondary">📎</button>
			</div>
		</div>

		<div class="col-md-3 border-start">
			<h5 class="text-primary">Thông tin nhóm</h5>
			<div id="groupInfo" class="p-2 small text-muted">Đang ở chế độ **Chat chung**</div>
		</div>
	</div>
</div>

<div class="modal fade" id="createGroupModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header"><h5 class="modal-title">Tạo nhóm mới</h5></div>
			<div class="modal-body">
				<input id="groupName" class="form-control mb-2" placeholder="Tên nhóm" />
				<textarea id="groupDesc" class="form-control mb-2" placeholder="Mô tả nhóm"></textarea>
				<input id="groupPin" class="form-control mb-2" maxlength="4" placeholder="Mã PIN (4 số)" />
				<div class="form-check mb-2">
					<input class="form-check-input" type="checkbox" id="privateGroup" />
					<label class="form-check-label">Nhóm riêng (yêu cầu PIN)</label>
				</div>

				<label for="groupMembers" class="form-label">Chọn thành viên đang online (Giữ Ctrl/Cmd để chọn nhiều)</label>
				<select id="groupMembers" class="form-control" multiple style="min-height: 100px;"></select>

			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
				<button id="createGroupBtn" class="btn btn-success">Tạo</button>
			</div>
		</div>
	</div>
</div>

<script>
	const username = prompt("Nhập tên của bạn:") || "Khách";
	const conn = new signalR.HubConnectionBuilder()
		.withUrl(`/chatHub?username=${encodeURIComponent(username)}`)
		.build();

	let currentGroup = null;
	let onlineUsers = [];

	async function startConn() {
		try {
			await conn.start();
			console.log("Connected as", username);
			conn.invoke("GetGroups");
			document.getElementById("messages").innerHTML = "";
			updateChatMode("public");
		} catch (err) {
			console.error("Reconnect...", err);
			setTimeout(startConn, 3000);
		}
	}
	startConn();

	const createGroupModal = new bootstrap.Modal(document.getElementById("createGroupModal"));

	function updateChatMode(mode, name = null) {
		currentGroup = name;
		const info = document.getElementById("groupInfo");
		const msgBox = document.getElementById("messages");

		if (mode === "public") {
			info.innerHTML = 'Đang ở chế độ **Chat chung**';
			msgBox.innerHTML = '';
			appendMsg("Đã chuyển sang chế độ Chat chung.", "system");
		} else if (mode === "group" && name) {
			msgBox.innerHTML = '';
			appendMsg(`Đã tham gia nhóm **${name}**.`, "system");
		}
	}

	// 🧩 Sự kiện từ server (Giữ nguyên)
	conn.on("UpdateUserList", users => {
		onlineUsers = users;
		const list = document.getElementById("userList");
		list.innerHTML = "";
		users.forEach(u => {
			const li = document.createElement("li");
			li.className = "list-group-item";
			li.textContent = u;
			list.appendChild(li);
		});
	});

	conn.on("ReceiveGroups", groups => {
		const list = document.getElementById("groupList");
		list.innerHTML = "";
		groups.forEach(g => {
			const li = document.createElement("li");
			li.className = "list-group-item list-group-item-action";
			li.innerHTML = `<strong>${g.name}</strong> ${g.isPrivate ? "🔒" : ""}`;
			li.onclick = () => {
				updateChatMode("group", g.name);
				joinGroup(g.name, g.isPrivate);
			};
			list.appendChild(li);
		});
	});

	conn.on("ReceiveMessage", msgObj => {
		if (currentGroup) return;
		renderMessage(msgObj.sender, msgObj);
	});

	conn.on("JoinedGroup", group => {
		currentGroup = group.name;
		document.getElementById("groupInfo").innerHTML = `
			<b>${group.name}</b><br>${group.description}<br>
			<small>${group.members.length} thành viên. Tạo bởi: ${group.createdBy}</small>`;
		document.getElementById("messages").innerHTML = "";
	});

	conn.on("UserJoinedGroup", (user, group) => appendMsg(`${user} đã tham gia nhóm ${group}`, "system"));
	conn.on("UserLeftGroup", (user, group) => appendMsg(`${user} rời nhóm ${group}`, "system"));

	conn.on("ReceiveGroupMessage", (msgObj) => {
		if (msgObj.group !== currentGroup) return;
		renderMessage(msgObj.sender, msgObj);
	});

	conn.on("UploadFailed", msg => appendMsg(`[LỖI FILE]: ${msg}`, "system"));
	conn.on("GroupError", msg => alert(msg));
	conn.on("JoinFailed", msg => alert(msg));

	// 📩 Gửi tin nhắn (Giữ nguyên)
	document.getElementById("sendBtn").onclick = async () => {
		const input = document.getElementById("messageInput");
		const msg = input.value.trim();
		if (!msg) return;

		try {
			if (currentGroup) {
				await conn.invoke("SendGroupMessage", currentGroup, username, msg);
			} else {
				await conn.invoke("SendMessage", username, msg);
			}
			input.value = "";
		} catch (e) {
			 appendMsg(`Lỗi khi gửi: ${e.message}`, "system");
		}
	};

	// ⌨️ THÊM: Gửi tin nhắn bằng phím Enter
	document.getElementById("messageInput").addEventListener("keydown", function (event) {
		if (event.keyCode === 13) {
			event.preventDefault();
			document.getElementById("sendBtn").click();
		}
	});

	// 💬 Nút Chat chung (Giữ nguyên)
	document.getElementById("publicChatBtn").onclick = () => updateChatMode("public");

	// 📎 Gửi file / ảnh (Giữ nguyên)
	document.getElementById("sendFileBtn").onclick = () => document.getElementById("fileInput").click();
	document.getElementById("fileInput").onchange = async e => {
		const file = e.target.files[0];
		if (!file) return;

		const reader = new FileReader();
		reader.onload = async () => {
			const base64Data = reader.result;

			try {
				if (currentGroup) {
					await conn.invoke("SendGroupFile", currentGroup, username, file.name, base64Data);
				} else {
					await conn.invoke("SendPublicFile", username, file.name, base64Data);
				}
			} catch (e) {
				appendMsg(`Lỗi khi gửi file: ${e.message}`, "system");
			}
		};
		reader.readAsDataURL(file);
	};

	// 🧱 Hàm join group (Giữ nguyên)
	async function joinGroup(name, isPrivate) {
		let pin = null;
		if (isPrivate) pin = prompt("Nhập mã PIN để tham gia:");
		try {
			 await conn.invoke("JoinGroup", name, username, pin);
		} catch (e) {
			appendMsg(`Lỗi JoinGroup: ${e.message}`, "system");
		}
	}

	// THÊM: Sự kiện điền danh sách thành viên khi Modal mở (Giữ nguyên)
	document.getElementById('createGroupModal').addEventListener('show.bs.modal', function () {
		const select = document.getElementById('groupMembers');
		select.innerHTML = '';

		onlineUsers.forEach(u => {
			if (u !== username) {
				const option = document.createElement('option');
				option.value = u;
				option.textContent = u;
				select.appendChild(option);
			}
		});
	});

	// 🧱 Tạo nhóm mới (Giữ nguyên logic đã sửa)
	document.getElementById("createGroupBtn").onclick = async () => {
		const name = groupName.value.trim();
		const desc = groupDesc.value.trim();
		const pin = groupPin.value.trim();
		const isPrivate = privateGroup.checked;

		const memberSelect = document.getElementById('groupMembers');
		const selectedMembers = Array.from(memberSelect.options)
									 .filter(option => option.selected)
									 .map(option => option.value);

		if (!name) return alert("Vui lòng nhập tên nhóm!");
		if (isPrivate && !pin) return alert("Nhóm riêng cần mã PIN!");

		await conn.invoke("CreateGroup", name, desc, username, null, selectedMembers, isPrivate, pin);
		createGroupModal.hide();
	};

	// 🎨 Render tin nhắn (Giữ nguyên)
	function renderMessage(user, msg) {
		const box = document.getElementById("messages");
		const div = document.createElement("div");
		div.className = "mb-2 d-flex " + (user === username ? "justify-content-end" : "justify-content-start");

		const contentDiv = document.createElement("div");
		contentDiv.className = "p-2 rounded shadow-sm " + (user === username ? "bg-primary text-white" : "bg-light");
		contentDiv.style.maxWidth = "70%";

		if (msg.type === "image") {
			contentDiv.innerHTML = `<b>${user}:</b><br><img src="${msg.content}" class="rounded border mt-1" style="max-width: 100%; max-height: 200px;">`;
		} else if (msg.type === "file") {
			const fileName = msg.fileName || msg.content.split('/').pop();
			contentDiv.innerHTML = `<b>${user}:</b> 📎 <a href="${msg.content}" target="_blank" class="text-reset"><u>${fileName}</u></a>`;
		} else {
			contentDiv.innerHTML = `<b>${user}:</b> ${msg.content}`;
		}

		div.appendChild(contentDiv);
		box.appendChild(div);
		box.scrollTop = box.scrollHeight;
	}

	function appendMsg(text, type = "system") {
		const box = document.getElementById("messages");
		const div = document.createElement("div");
		div.className = type === "system" ? "text-center text-muted fst-italic small mb-1" : "mb-2";
		div.textContent = text;
		box.appendChild(div);
		box.scrollTop = box.scrollHeight;
	}
</script>